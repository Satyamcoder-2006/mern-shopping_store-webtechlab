{
  "name": "forme-clothing-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"./node_modules/**\" --exclude \"./dist/**\" server.ts",
    "start": "tsx scripts/start-production.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test backend/*.test.ts src/utils/listen.test.ts src/store/api.test.ts shared/password.test.cjs",
    "test:media": "node --experimental-strip-types scripts/verify-media.mjs",
    "test:atlas": "node scripts/verify-commerce.mjs",
    "admin:setup": "node scripts/setup-admin.mjs",
    "catalog:expand": "node --experimental-strip-types scripts/expand-catalog.mjs",
    "audit:files": "node scripts/audit-repository.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:setup": "node --experimental-strip-types scripts/initialize-database.mjs",
    "check": "npm run audit:files && npm run lint && npm test && npm run build",
    "test:neon": "node --experimental-strip-types scripts/verify-neon.mjs",
    "env:check": "node scripts/check-environment.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.6.0-beta",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.11.4",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "description": "FORME: a MERN clothing store with inventory, community outfit voting, reviews and secure account management.",
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satyamcoder-2006/mern-shopping_store-webtechlab.git"
  },
  "overrides": {
    "better-auth": "^1.7.17",
    "@better-auth/core": "^1.7.17",
    "@better-auth/drizzle-adapter": "^1.7.17",
    "zod": "^4.6.7"
  }
}
