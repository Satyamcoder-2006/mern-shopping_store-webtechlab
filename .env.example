# Server-only values. Never prefix secrets with VITE_.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopDB?retryWrites=true&w=majority
MONGO_DB_NAME=shopDB
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3000
ADMIN_EMAIL=admin@example.com
# Production always uses Secure cookies; localhost dev can use false.
COOKIE_SECURE=false
# Optional Neon Auth (Managed Better Auth) URL from the Neon Auth dashboard.
# Both URLs must point to the same Neon branch. Leave blank to keep email login only.
NEON_AUTH_URL=
# Public URL only; embedded in the browser bundle. No Google client secret here.
VITE_NEON_AUTH_URL=
